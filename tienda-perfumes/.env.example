SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
ADMIN_TOKEN=cambia-esto-por-un-secreto-largo-y-aleatorio

# Mercado Pago: Tus integraciones -> Credenciales de producción -> Access Token
MP_ACCESS_TOKEN=tu-access-token-de-produccion
# Opcional pero recomendado: Tus integraciones -> Webhooks -> Firma secreta
MP_WEBHOOK_SECRET=tu-firma-secreta-de-webhooks

# URL pública del sitio ya deployado (sin barra final). Si la omitís, se
# deduce del header Host de cada request.
SITE_URL=https://tu-tienda.vercel.app

# Email transaccional (opcional). Sin esto, los pedidos igual se guardan y
# se pagan, pero no se manda el mail al proveedor ni la confirmación al
# cliente. Conseguí la API key en resend.com (tiene plan gratis).
RESEND_API_KEY=tu-api-key-de-resend
EMAIL_FROM=Tienda de Perfumes <pedidos@tudominio.com>
PROVEEDOR_EMAIL=proveedor@ejemplo.com
